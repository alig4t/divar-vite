# Environment Variables Example
# Copy this file to .env.local and modify as needed

# Use static API instead of JSON Server (for testing production behavior)
# VITE_USE_STATIC_API=true

# For JSONBin.io API (if using external API)
# VITE_JSONBIN_ID=your_bin_id_here
# VITE_JSONBIN_KEY=your_api_key_here